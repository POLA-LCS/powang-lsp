{
  "name": "powang",
  "displayName": "Powang",
  "description": "Syntax highlighting, diagnostics and completion for the Powang language",
  "version": "0.2.0",
  "publisher": "POLA-LCS",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/POLA-LCS/powang-vscode"
  },
  "bugs": {
    "url": "https://github.com/POLA-LCS/powang-vscode/issues"
  },
  "homepage": "https://github.com/POLA-LCS/powang-vscode#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "powang",
    "language",
    "syntax highlighting",
    "lsp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:powang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "powang",
        "aliases": ["Powang"],
        "extensions": [".po"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "powang",
        "scopeName": "source.powang",
        "path": "./syntax/powang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Powang",
      "properties": {
        "powang.server.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to start the powang LSP server."
        },
        "powang.server.extraArgs": {
          "type": "array",
          "default": [],
          "description": "Extra arguments passed to the powang LSP server."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  }
}
