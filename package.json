{
  "name": "powang-lsp",
  "displayName": "Powang LSP",
  "description": "Language support for the Powang programming language",
  "version": "0.14.3",
  "publisher": "POLA-LCS",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/POLA-LCS/powang-lsp"
  },
  "bugs": {
    "url": "https://github.com/POLA-LCS/powang-lsp/issues"
  },
  "homepage": "https://github.com/POLA-LCS/powang-lsp#readme",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "powang",
    "language",
    "syntax highlighting",
    "lsp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:powang",
    "onCommand:powang.server.restart"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Powang Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/powang-dark-color-theme.json"
      }
    ],
    "languages": [
      {
        "id": "powang",
        "aliases": ["Powang"],
        "extensions": [".po"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "powang",
        "scopeName": "source.powang",
        "path": "./syntax/powang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "powang.server.restart",
        "title": "Powang: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Powang",
      "properties": {
        "powang.server.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to start the powang LSP server."
        },
        "powang.server.extraArgs": {
          "type": "array",
          "default": [],
          "description": "Extra arguments passed to the powang LSP server."
        },
        "powang.server.repositoryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the powang repository root. The bundled LSP server imports the language implementation from this directory."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  }
}
